# 하나만 넣어도 돼요. 둘 다 넣으면 네이버·다음 결과를 합쳐서 보여줘요.
# 네이버: https://developers.naver.com/apps → 애플리케이션 등록 → 사용 API "검색"
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 카카오(다음 검색): https://developers.kakao.com → 앱 → 플랫폼 키 → REST API 키
KAKAO_REST_API_KEY=

# 선택
# PORT=8787
# HOST=127.0.0.1          # 서버에 올릴 땐 0.0.0.0
# CHECK_BODIES=0          # 블로그 본문을 열지 않고 검색 결과 요약만으로 판단
# FETCH_USER_AGENT=...    # 본문을 열 때 보낼 User-Agent
